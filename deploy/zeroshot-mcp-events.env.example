# /etc/zeroshot-mcp-events.env — install with mode 0600, owner zs-mcp.
# Tokens belong here, not in ExecStart (argv is world-readable in /proc).

NTFY_URL=https://ntfy.naqerl.com
NTFY_TOPIC=zs-runs
# NTFY_TOKEN=tk_replace_me

# Optional: where the zsp binary lives when it is not on PATH.
# ZSP_BIN=/usr/local/bin/zsp
